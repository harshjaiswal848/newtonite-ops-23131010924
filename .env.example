# Environment Configuration Example
PROJECT_NAME="Newtonite Operations Under Pressure"
ENVIRONMENT=production

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=newtonite_ops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/newtonite_ops
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/newtonite_ops

# Authentication & Security
SECRET_KEY=change_this_to_a_super_secure_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Outbox Worker
OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_MAX_RETRIES=5
OUTBOX_BATCH_SIZE=10

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
